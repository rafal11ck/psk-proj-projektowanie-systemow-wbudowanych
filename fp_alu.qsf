# Projekt demonstracyjny ALU zmiennoprzecinkowego.
# Top-level jest schematem blokowym demo.bdf.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY demo

# Kolejnosc ma znaczenie: pakiet i moduly nizszego poziomu musza byc
# analizowane przed wrapperami uzywanymi w schemacie BDF.
set_global_assignment -name VHDL_FILE src/fp_pkg.vhd
set_global_assignment -name VHDL_FILE src/fp_normalize.vhd
set_global_assignment -name VHDL_FILE src/clk_div.vhd
set_global_assignment -name VHDL_FILE src/fp_counter.vhd
set_global_assignment -name VHDL_FILE src/fp_counter_bdf.vhd
set_global_assignment -name VHDL_FILE src/start_delay.vhd
set_global_assignment -name VHDL_FILE src/fp_add_sub.vhd
set_global_assignment -name VHDL_FILE src/fp_mul.vhd
set_global_assignment -name VHDL_FILE src/alu.vhd
set_global_assignment -name VHDL_FILE src/alu_bdf.vhd
set_global_assignment -name BDF_FILE demo.bdf

set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name LAST_QUARTUS_VERSION 13.1

# Ustawienia netlisty funkcjonalnej uzywanej przez skrypty ModelSim.
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_NETLIST_WRITER_OUTPUT_DIR simulation/qsim/ -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST ON -section_id eda_simulation

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top